{
  "name": "dream-course",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:content && npm run lint && npm run format:check && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
